# Virtual Environment
venv/
.venv/
ENV/

# Python Cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Sensitive Credentials / Secrets
.env

# OS files
.DS_Store
Thumbs.db

# VS Code editor settings (personal, auto-generated by VS Code)
.vscode/

# Logs
logs/

# Generated CSV Reports & Backtest Output (auto-generated, do not commit)
csv_files/
stats/charts/
cryptosight/stats/charts/

# ─── Frontend ────────────────────────────────────────────────────────────────

# Node modules (heaviest folder — never commit this)
frontend/node_modules/

# Vite build output
frontend/dist/
frontend/dist-ssr/

# Vite internal cache
frontend/.vite/

# Environment variables (frontend)
frontend/.env
frontend/.env.local
frontend/.env.*.local

# Editor / OS junk inside frontend
frontend/.DS_Store
frontend/Thumbs.db

# npm / yarn debug logs
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
